# ===== 推理引擎与接口配置 =====
# 支持兼容 OpenAI 标准格式的推理接口服务
PAPERAGENT_PROXY_URL=http://127.0.0.1:8000/v1
PAPERAGENT_PROXY_API_KEY=your_api_key_here
PAPERAGENT_BACKEND=proxy
PAPERAGENT_TIMEOUT=300

# ===== 默认模型档位 =====
# 可选值: flash (极速推理) | thinking (深度推演) | pro (综合研报)
PAPERAGENT_MODEL_PROFILE=flash

# 各档位模型映射（可根据所接入的模型服务自定义）
PAPERAGENT_FLASH_MODEL=gemini-3.8-flash-high
PAPERAGENT_THINKING_MODEL=claude-sonnet-4-6-thinking
PAPERAGENT_PRO_MODEL=gemini-3.1-pro

# ===== 知识库与嵌入向量检索配置 =====
PAPERAGENT_MAX_CONTEXT_CHARS=8000
PAPERAGENT_TOP_K_DOCS=10
